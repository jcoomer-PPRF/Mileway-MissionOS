{
  "name": "missionos",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "MissionOS — Mission Delivery, Operations, and shared organizational tools.",
  "scripts": {
    "dev": "vite",
    "dev:md01": "vite --mode md01 --open /demo.html",
    "build:md01": "tsc --noEmit && vite build --mode md01",
    "preview:md01": "vite preview --mode md01 --outDir dist-md01",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.tests.json",
    "preview": "vite preview",
    "db:types": "supabase gen types typescript --linked > src/types/supabase.ts",
    "test": "node --import ./tests/register.mjs tests/integrity.test.ts && node --import ./tests/register.mjs tests/mission-delivery.test.ts",
    "test:e2e": "playwright test",
    "test:md01:built": "playwright test --config playwright.md01.config.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.9.1",
    "@supabase/supabase-js": "^2.45.4",
    "@tanstack/react-query": "^5.59.0",
    "@tanstack/react-table": "^8.20.5",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "date-fns": "^3.6.0",
    "lucide-react": "^0.451.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.53.0",
    "react-router-dom": "^6.26.2",
    "recharts": "^2.12.7",
    "tailwind-merge": "^2.5.2",
    "xlsx": "^0.18.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.7.4",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.2",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.6.2",
    "vite": "^5.4.8"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
